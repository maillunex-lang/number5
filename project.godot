; Lunex AFK UI Prototype v0.1
; Godot 4.7.2 — Anime Fantasy / Premium Mobile RPG

config_version=5

[application]

config/name="Lunex AFK"
config/description="UI Prototype v0.1 — локальный демо-клиент (не онлайн)"
config/version="0.1.0"
run/main_scene="res://scenes/bootstrap/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icon.svg"

[autoload]

AppState="*res://scripts/autoload/app_state.gd"
ContentPackageLoader="*res://scripts/autoload/content_package_loader.gd"
DemoData="*res://scripts/autoload/demo_data.gd"
UIStateManager="*res://scripts/autoload/ui_state_manager.gd"
ThemeManager="*res://scripts/autoload/theme_manager.gd"
AssetLoader="*res://scripts/autoload/asset_loader.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
NotificationManager="*res://scripts/autoload/notification_manager.gd"
ModalManager="*res://scripts/autoload/modal_manager.gd"
ScreenRouter="*res://scripts/autoload/screen_router.gd"
SmokeRunner="*res://scripts/autoload/smoke_runner.gd"
ScreenshotRunner="*res://scripts/autoload/screenshot_runner.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://theme/lunex_theme.tres"
common/drop_mouse_on_gui_input_disabled=true

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.14, 1)

[android]

modules=""
